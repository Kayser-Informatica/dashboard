#!/usr/bin/env bash
# ==============================================================================
# Vigilant - Git Pre-Commit Security Hook
# Impede o commit acidental de chaves, senhas, tokens e arquivos de ambiente (.env)
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 [Pre-Commit Security] Verificando arquivos em stage por credenciais expostas...${NC}"

HAS_ERROR=0

# 1. Bloqueia commit direto de arquivos .env (exceto .env.example)
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '^(\.env|\.env\.local|\.env\.production|\.env\.staging|\.env\.testing)$')
if [ -n "$STAGED_ENV_FILES" ]; then
    echo -e "${RED}❌ ERRO DE SEGURANÇA: Tentativa de commitar arquivo de ambiente confidencial:${NC}"
    for file in $STAGED_ENV_FILES; do
        echo -e "   ${RED}🚫 $file${NC}"
    done
    echo -e "${YELLOW}👉 Dica: Arquivos .env devem ficar no .gitignore e nunca serem enviados ao repositório.${NC}"
    HAS_ERROR=1
fi

# 2. Padrões de chaves, tokens e certificados que não devem estar em arquivos rastreados
PATTERNS=(
    "BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY"
    "AKIA[0-9A-Z]{16}"
    "ghp_[0-9a-zA-Z]{36}"
    "github_pat_[0-9a-zA-Z_]{82}"
)

# 3. Varredura de linhas adicionadas nos arquivos em stage
for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(git diff --cached -S"$pattern" --pickaxe-regex --name-only | grep -v '\.env\.example' | grep -v '\.githooks/pre-commit' | grep -v 'SecurityHardeningTest\.php')
    if [ -n "$MATCHES" ]; then
        echo -e "${RED}❌ ERRO DE SEGURANÇA: Encontrado padrão suspeito de credencial ('$pattern') nos arquivos:${NC}"
        for match in $MATCHES; do
            echo -e "   ${RED}🚫 $match${NC}"
        done
        HAS_ERROR=1
    fi
done

# 4. Verificação de APP_KEY hardcoded em docker-compose ou arquivos de configuração
HARDCODED_APP_KEY=$(git diff --cached -U0 | grep -E '^\+[[:space:]]*APP_KEY:[[:space:]]*.*base64:[A-Za-z0-9+/=]{44}' | grep -v '\.env\.example')
if [ -n "$HARDCODED_APP_KEY" ]; then
    echo -e "${RED}❌ ERRO DE SEGURANÇA: APP_KEY com valor fixo detectada no commit:${NC}"
    echo -e "   ${YELLOW}$HARDCODED_APP_KEY${NC}"
    echo -e "${YELLOW}👉 Dica: Utilize '\${APP_KEY}' delegando o valor para a variável do .env.${NC}"
    HAS_ERROR=1
fi

# 5. Verificação de senhas fixas em arquivos docker-compose (*.yml, *.yaml)
HARDCODED_PASSWORDS=$(git diff --cached -U0 '*.yml' '*.yaml' | grep -E '^\+[[:space:]]*(MYSQL_PASSWORD|MYSQL_ROOT_PASSWORD|DB_PASSWORD):[[:space:]]*[a-zA-Z0-9_\-\@\#\$]+' | grep -v '\${')
if [ -n "$HARDCODED_PASSWORDS" ]; then
    echo -e "${RED}❌ ERRO DE SEGURANÇA: Senha de banco de dados fixa detectada em arquivo compose:${NC}"
    echo -e "   ${YELLOW}$HARDCODED_PASSWORDS${NC}"
    echo -e "${YELLOW}👉 Dica: Utilize variáveis de ambiente (ex: '\${DB_PASSWORD}').${NC}"
    HAS_ERROR=1
fi

if [ $HAS_ERROR -eq 1 ]; then
    echo ""
    echo -e "${RED}🛑 COMMIT ABORTADO para proteger a segurança do projeto!${NC}"
    echo -e "${YELLOW}Corrija os problemas acima antes de tentar commitar novamente.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ [Pre-Commit Security] Nenhuma chave ou credencial exposta encontrada. Commit liberado!${NC}"
exit 0
